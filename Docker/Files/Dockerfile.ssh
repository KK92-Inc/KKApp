FROM oven/bun:1-alpine AS build-auth

WORKDIR /app
COPY App.Git/App.Git.Auth/package.json App.Git/App.Git.Auth/tsconfig.json ./
RUN bun install --frozen-lockfile
COPY App.Git/App.Git.Auth/ .
RUN bun --bun build --compile --minify ./src/index.ts --outfile /app/output/auth

# ============================================================================

FROM oven/bun:1-alpine AS build-shell

WORKDIR /app
COPY App.Git/App.Git.Shell/package.json App.Git/App.Git.Shell/tsconfig.json ./
RUN bun install --frozen-lockfile
COPY App.Git/App.Git.Shell/ .
RUN bun --bun build --compile --minify ./src/index.ts --outfile /app/output/shell

# ============================================================================

FROM oven/bun:1-alpine

ARG GIT_UID=10001
ARG GIT_GID=10001

# NOTE: 1000 is NOT available here -- oven/bun:1-alpine already bakes in a
# "bun" user/group at uid/gid 1000 (see oven-sh/bun's own alpine Dockerfile),
# so building this image as-is with GIT_UID/GID=1000 fails at addgroup with
# "gid '1000' in use". 10001 is clear of that account, Alpine's other
# reserved system ids, and the aspnet chiseled non-root uid (64198) used by
# git-api's container (see App.Git.Http.csproj -> <ContainerUser>). If you
# ever change this value, it must be changed identically in
# App.Git.Http.csproj's <ContainerUser> and nowhere else needs to match at
# build time (entrypoint.sh reads the actual runtime uid/gid from env instead).

RUN apk add --no-cache openssh git ca-certificates \
    && addgroup -S -g ${GIT_GID} git \
    && adduser -D -h /home/git -s /bin/sh -u ${GIT_UID} -G git git \
    && passwd -d git \
    && addgroup -S sshenv \
    && addgroup git sshenv \
    && addgroup nobody sshenv \
    && mkdir -p /var/run/sshd /home/git/repos \
    && chown ${GIT_UID}:${GIT_GID} /home/git/repos \
    && chmod 775 /home/git/repos \
    && git config --system safe.directory '*'

COPY --from=build-shell /app/output/shell /home/git/shell
COPY --from=build-auth  /app/output/auth  /usr/local/bin/auth

COPY Configurations/Shell/sshd_config /etc/ssh/sshd_config
COPY Configurations/Shell/entrypoint.sh /usr/local/bin/entrypoint.sh

RUN chown root:root /usr/local/bin/auth /usr/local/bin/entrypoint.sh \
    && chown git:git /home/git/shell \
    && chmod 755 /usr/local/bin/auth /usr/local/bin/entrypoint.sh /home/git/shell \
    && chmod 600 /etc/ssh/sshd_config

EXPOSE 22
VOLUME ["/home/git/repos"]
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]